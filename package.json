{
  "name": "streamnest-nuvio-plugins",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Native Nuvio JavaScript providers for German movies, series, and Xtream VOD.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"test/*.test.ts\"",
    "check": "npm run typecheck && npm run build && npm test"
  },
  "dependencies": {
    "cheerio": "1.2.0",
    "fast-xml-parser": "5.11.1"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "esbuild": "0.28.2",
    "quickjs-emscripten": "0.32.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
